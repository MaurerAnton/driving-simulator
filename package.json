{
  "name": "fahrsim-baunatal",
  "version": "1.6.0",
  "description": "Freier 3D-Fahrschulsimulator für Nordhessen – deutsche Verkehrsregeln lernen, mit einem Fahrzeug jeder Führerscheinklasse (AGPL-3.0-only).",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/vehicle/*.test.ts\" \"tests/reality/*.test.ts\" \"tests/game/*.test.ts\" \"tests/i18n/*.test.ts\" \"tests/world/*.test.ts\" \"tests/sim/*.test.ts\" \"tests/ui/*.test.ts\"",
    "i18n:check": "node tools/i18n-check.ts",
    "panos:index": "node tools/panos/index-panos.ts",
    "map:extract": "node --max-old-space-size=6144 tools/osm-extract.ts",
    "map:build": "node tools/build-map.ts",
    "map:addresses": "node --max-old-space-size=3072 tools/build-addresses.ts",
    "map:all": "npm run map:extract && npm run map:build && npm run map:addresses && npm run map:stops && npm run map:lines && npm run map:buslines && npm run map:signs && npm run map:far && npm run map:timetable && npm run map:services",
    "map:stops": "node --max-old-space-size=3072 tools/build-stops.ts",
    "map:lines": "node --max-old-space-size=1536 tools/build-lines.ts",
    "map:buslines": "node --max-old-space-size=1536 tools/build-buslines.ts",
    "map:timetable": "node --max-old-space-size=1536 tools/build-timetable.ts",
    "map:signs": "node --max-old-space-size=1536 tools/build-signs.ts",
    "map:services": "node --max-old-space-size=1536 tools/build-services.ts",
    "map:far": "node --max-old-space-size=2048 tools/build-far.ts",
    "test:traffic": "node tests/traffic.sim.ts 5",
    "test:drive": "node tests/drive.sim.ts",
    "test:drive:truck": "node tests/drive.sim.ts --truck priority rural ceExam",
    "test:drive:traffic": "node tests/drive.sim.ts --traffic",
    "map:graph": "node --max-old-space-size=6144 --expose-gc tools/build-graph.ts",
    "map:check": "node --max-old-space-size=3072 tools/check-lanes.ts",
    "map:fetch": "node tools/fetch-map.ts",
    "map:pack": "rm -f data/work/map.tar.* && tar -cf - -C public map | split -b 100M -d -a 2 - data/work/map.tar."
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/earcut": "^3.2.4",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "earcut": "^3.2.4",
    "playwright-core": "^1.65.1",
    "saxes": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MaurerAnton/driving-simulator.git"
  },
  "homepage": "https://maureranton.github.io/driving-simulator/",
  "keywords": [
    "fahrschule",
    "fahrsimulator",
    "driving-simulator",
    "stvo",
    "baunatal",
    "openstreetmap",
    "threejs",
    "agpl"
  ]
}
