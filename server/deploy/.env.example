# Copy to .env and fill in.
FAHRSIM_DOMAIN=fahrsim.example.org
# a long random secret, e.g. from: openssl rand -base64 32   – never change it later (all tokens would stop working)
FAHRSIM_PEPPER=
FAHRSIM_ORIGINS=https://maureranton.github.io,http://localhost:*
FAHRSIM_REGISTRATION=false
FAHRSIM_MOTD=
